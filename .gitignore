# Python 가상환경과 캐시
.venv*/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# 로컬 설정
.env
.env.*
!.env.example
.idea/
.vscode/
*.lnk
Thumbs.db
Desktop.ini
*.log
~$*
.~lock.*

# AI 생성 이미지·모델을 포함한 로컬 에셋과 실험·발표 산출물
# 히로인 AI 레퍼런스는 폴더 위치가 바뀌어도 제외
**/heroine_references/
**/rose_references/
/data/*
!/data/fonts/
/data/fonts/*
!/data/fonts/README.md
!/data/fonts/s_core_dream/
!/data/fonts/Cafe24Ohsquare-v2.0/
/data/fonts/Cafe24Ohsquare-v2.0/*
!/data/fonts/Cafe24Ohsquare-v2.0/Cafe24Ohsquare-v2.0.otf
!/data/fonts/Cafe24Ohsquare-v2.0/LICENSE.txt
!/data/fonts/Cafe24OhsquareAir-v2.0/
/data/fonts/Cafe24OhsquareAir-v2.0/*
!/data/fonts/Cafe24OhsquareAir-v2.0/Cafe24OhsquareAir-v2.0.otf
!/data/fonts/Cafe24OhsquareAir-v2.0/LICENSE.txt
!/data/fonts/학교안심 운동장/
/data/fonts/학교안심 운동장/*
!/data/fonts/학교안심 운동장/HakgyoansimUndongjangOTFL.otf
!/data/fonts/학교안심 운동장/LICENSE.txt
/output/
# 툴의 로컬 저장 프로젝트·레이아웃·영역 작업
/Tools/*/workspace/
/docs/report-archive/
# 이전 로컬 전용 보고서는 legacy로 옮긴 뒤에도 제외
/legacy/lora/local-only/
/docs/**/*.pptx
!/docs/presentation/발표자료.pptx
!/docs/presentation/기획서.pptx
