!/data/fonts/ferrial_hud_square_wide/LICENSE.txt
!/data/fonts/ferrial_hud_square_wide/manifest.json
!/data/fonts/ferrial_hud_square_wide/README.md
/output/
/samples/sword_movement/generated/
/samples/sound_effects/generated/
# 자동화의 로컬 실행 파일·의존성·보존 입력
/automate/bin/
/automate/runtime/
/automate/packages/
/automate/workspace/
/automate/*.local.json
# 툴의 로컬 저장 프로젝트·레이아웃·영역 작업
/Tools/*/workspace/
/Tools/blender_pipeline/99_Archives/
/docs/report-archive/
# 이전 로컬 전용 보고서는 legacy로 옮긴 뒤에도 제외
/legacy/lora/local-only/
/docs/**/*.pptx
!/docs/presentation/발표자료.pptx
!/docs/presentation/기획서.pptx

# 장기 서사와 관련 대화 기록은 로컬 전용
/docs/private/
/docs/adv_narrative_plan.md
/docs/FerrialDrive_MainNarrative*.md
/docs/ai-dev-log/*main-narrative*.md
/docs/ai-dev-log/*adv-agi-route*.md
/docs/ai-dev-log/*agi-heroine*.md
