# Python 가상환경과 캐시
.venv*/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# 로컬 설정
.env
.env.*
!.env.example
.idea/
.vscode/
/.codex/
*.lnk
Thumbs.db
Desktop.ini
*.log
~$*
.~lock.*

# AI 생성 이미지·모델을 포함한 로컬 에셋과 실험·발표 산출물
# 히로인 AI 레퍼런스는 폴더 위치가 바뀌어도 제외
**/heroine_references/
**/rose_references/
/data/*
!/data/README.md
!/data/fonts/
/data/fonts/*
!/data/fonts/README.md
!/data/fonts/s_core_dream/
!/data/fonts/Cafe24Ohsquare-v2.0/
/data/fonts/Cafe24Ohsquare-v2.0/*
!/data/fonts/Cafe24Ohsquare-v2.0/Cafe24Ohsquare-v2.0.otf
!/data/fonts/Cafe24Ohsquare-v2.0/LICENSE.txt
!/data/fonts/Cafe24OhsquareAir-v2.0/
/data/fonts/Cafe24OhsquareAir-v2.0/*
!/data/fonts/Cafe24OhsquareAir-v2.0/Cafe24OhsquareAir-v2.0.otf
!/data/fonts/Cafe24OhsquareAir-v2.0/LICENSE.txt
!/data/fonts/학교안심 운동장/
/data/fonts/학교안심 운동장/*
!/data/fonts/학교안심 운동장/HakgyoansimUndongjangOTFL.otf
!/data/fonts/학교안심 운동장/LICENSE.txt
!/data/fonts/gamwulchifreegothic/
/data/fonts/gamwulchifreegothic/*
!/data/fonts/gamwulchifreegothic/GamwulchiFreeGothic.otf
!/data/fonts/gamwulchifreegothic/gamwulchifg.pdf
!/data/fonts/gamwulchifreegothic/SOURCE.md
!/data/fonts/Paperlogy-1.001/
/data/fonts/Paperlogy-1.001/*
!/data/fonts/Paperlogy-1.001/Paperlogy-7Bold.ttf
!/data/fonts/Paperlogy-1.001/LICENSE.txt
!/data/fonts/SUITE-otf/
/data/fonts/SUITE-otf/*
!/data/fonts/SUITE-otf/SUITE-Bold.otf
!/data/fonts/SUITE-otf/SUITE-Light.otf
!/data/fonts/SUITE-otf/SUITE-Regular.otf
!/data/fonts/SUITE-otf/LICENSE
!/data/fonts/ferrial_hud_square/
/data/fonts/ferrial_hud_square/*
!/data/fonts/ferrial_hud_square/FerrialHudSquare-Regular.otf
!/data/fonts/ferrial_hud_square/LICENSE.txt
!/data/fonts/ferrial_hud_square/manifest.json
!/data/fonts/ferrial_hud_square/README.md
!/data/fonts/ferrial_hud_square_wide/
/data/fonts/ferrial_hud_square_wide/*
